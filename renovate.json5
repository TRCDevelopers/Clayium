{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended"
  ],
  addLabels: ["renovate"],
  enabled: false,
  packageRules: [
    {
      matchFileNames: ["dependencies.gradle"],
      enabled: true,
    },
    {
      matchCategories: ["github-actions", "npm"],
      enabled: true,
    }
  ]
}
